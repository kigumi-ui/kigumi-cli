{
  "permissions": {
    "allow": [
      "mcp__chrome-devtools__evaluate_script",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm validate:registry)",
      "Bash(pnpm validate:templates)",
      "Bash(npx vitest:*)"
    ]
  },
  "enabledMcpjsonServers": ["storybook"],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-guardrails.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-quality-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-completion.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
