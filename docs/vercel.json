{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "cd .. && node scripts/setup-npmrc.mjs && cd docs && pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!skills|.well-known|assets|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
