{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/.well-known/$1"
    },
    {
      "source": "/skills/(.*)",
      "destination": "/skills/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
