# Web Awesome Pro authentication token
# Get your token from https://webawesome.com/pro
# Copy this file to .env and add your personal token
WEBAWESOME_NPM_TOKEN=your_token_here

# Chromatic project token, only needed to run `pnpm chromatic` locally.
# CI reads this from the CHROMATIC_PROJECT_TOKEN repository secret instead.
# Find it under Manage > Configure on the Chromatic project.
CHROMATIC_PROJECT_TOKEN=your_token_here
