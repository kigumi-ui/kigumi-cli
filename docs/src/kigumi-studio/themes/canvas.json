{
  "version": 1,
  "name": "Canvas",
  "shadowComponents": ["Card"],
  "light": {
    "--wa-color-brand": "#000000",
    "--wa-color-surface-raised": "#ffffff",
    "--wa-color-surface-default": "#f5f5f5",
    "--wa-color-surface-lowered": "#e8e8e8",
    "--wa-color-surface-border": "#000000",
    "--wa-color-text-normal": "#000000",
    "--wa-color-text-quiet": "#333333",
    "--wa-color-text-link": "#0c8ce9",
    "--wa-color-success": "#14ae5c",
    "--wa-color-warning": "#ffa629",
    "--wa-color-danger": "#f24822",
    "--wa-font-family-body": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "--wa-font-family-heading": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
    "--wa-font-weight-normal": "500",
    "--wa-font-weight-semibold": "600",
    "--wa-font-weight-bold": "700",
    "--wa-space-scale": "1.1",
    "--wa-border-radius-scale": "0",
    "--wa-border-width-scale": "2",
    "--wa-border-style": "solid",
    "--wa-shadow-opacity": "0.6",
    "--wa-shadow-offset-x-scale": "0.8",
    "--wa-shadow-offset-y-scale": "0.8",
    "--wa-shadow-blur-scale": "0",
    "--wa-shadow-spread-scale": "0",
    "--wa-transition-fast": "100ms",
    "--wa-transition-normal": "150ms",
    "--wa-transition-slow": "200ms",
    "--wa-transition-easing": "ease",
    "--wa-focus-ring-style": "solid"
  },
  "dark": {
    "--wa-color-surface-raised": "#2c2c2c",
    "--wa-color-surface-default": "#1e1e1e",
    "--wa-color-surface-lowered": "#0f0f0f",
    "--wa-color-surface-border": "#ffffff",
    "--wa-color-text-normal": "#ffffff",
    "--wa-color-text-quiet": "#b3b3b3",
    "--wa-color-text-link": "#78c9ff",
    "--wa-shadow-opacity": "0.6",
    "--wa-form-control-background-color": "#2c2c2c",
    "--wa-form-control-border-color": "#ffffff",
    "--wa-form-control-placeholder-color": "#666666"
  }
}
