{
  "version": 1,
  "name": "Shopaholic",
  "light": {
    "--wa-color-brand": "#95bf47",
    "--wa-color-surface-raised": "#ffffff",
    "--wa-color-surface-default": "#f7f7f7",
    "--wa-color-surface-lowered": "#ebebeb",
    "--wa-color-surface-border": "#d3d3d3",
    "--wa-color-text-normal": "#202223",
    "--wa-color-text-quiet": "#6d7175",
    "--wa-color-text-link": "#2c6ecb",
    "--wa-color-success": "#008060",
    "--wa-color-warning": "#ffc453",
    "--wa-color-danger": "#d72c0d",
    "--wa-font-family-body": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "--wa-font-family-heading": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "--wa-font-weight-normal": "400",
    "--wa-font-weight-semibold": "500",
    "--wa-font-weight-bold": "600",
    "--wa-font-size-scale": "1",
    "--wa-line-height-normal": "1.5",
    "--wa-space-scale": "1.2",
    "--wa-border-radius-scale": "1.2",
    "--wa-border-width-scale": "0.8",
    "--wa-color-shadow": "#000000",
    "--wa-shadow-opacity": "0.08",
    "--wa-shadow-offset-y-scale": "0.4",
    "--wa-shadow-blur-scale": "1.5",
    "--wa-shadow-spread-scale": "-0.2",
    "--wa-transition-fast": "100ms",
    "--wa-transition-normal": "200ms",
    "--wa-transition-slow": "300ms",
    "--wa-transition-easing": "ease-out"
  },
  "dark": {
    "--wa-color-surface-raised": "#303030",
    "--wa-color-surface-default": "#1a1a1a",
    "--wa-color-surface-lowered": "#0d0d0d",
    "--wa-color-surface-border": "#404040",
    "--wa-color-text-normal": "#e3e3e3",
    "--wa-color-text-quiet": "#b5b5b5",
    "--wa-color-text-link": "#6ab7ff",
    "--wa-shadow-opacity": "0.3",
    "--wa-form-control-background-color": "#303030",
    "--wa-form-control-border-color": "#525252",
    "--wa-form-control-placeholder-color": "#8a8a8a"
  }
}
