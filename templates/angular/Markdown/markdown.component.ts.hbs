import { Component, CUSTOM_ELEMENTS_SCHEMA, ElementRef, ViewChild, AfterViewInit, inject, Input } from '@angular/core';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';

/**
 * Renders markdown content in plain HTML
 *
 * @see https://webawesome.com/docs/components/markdown
 */
@Component({
  selector: 'k-markdown',
  standalone: true,
  schemas: [CUSTOM_ELEMENTS_SCHEMA],
  template: `
    <{{tagName}}
        #element
        [attr.tab-size]="tabSize">
      <ng-content />
    </{{tagName}}>
  `,
  styleUrl: './markdown.component.css',
})
export class {{name}}Component implements AfterViewInit {
  @ViewChild('element') elementRef!: ElementRef<WaElement>;
  private hostRef = inject(ElementRef<HTMLElement>);

  /** Tab stop width for whitespace normalization */
  @Input() tabSize?: number;

  ngAfterViewInit(): void {
    const el = this.elementRef.nativeElement;

    // Forward host attributes to inner wa-* element
    const host = this.hostRef.nativeElement;
    const hostStyle = host.getAttribute('style');
    if (hostStyle) {
      el.setAttribute('style', hostStyle);
      host.removeAttribute('style');
    }
    // When slotted, override display:contents so ::slotted() margins apply
    if (host.hasAttribute('slot')) {
      host.style.display = 'inline';
    }
  }

  /** Returns the shared Marked instance */
  getMarked(): unknown {
    return (this.elementRef.nativeElement as unknown as { marked?: unknown }).marked;
  }

  /** Re-renders all connected wa-markdown instances */
  updateAll(): void {
    const El = this.elementRef.nativeElement.constructor as unknown as { updateAll?: () => void };
    El?.updateAll?.();
  }

  /** Re-renders the markdown content */
  renderMarkdown(): void {
    (this.elementRef.nativeElement as unknown as { renderMarkdown?: () => void }).renderMarkdown?.();
  }
}
