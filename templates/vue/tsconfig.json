// "jsx" is intentionally omitted: vue-tsc compiles SFC <template> blocks
// via Vue's own SFC compiler, not React's JSX mode. Adding "jsx": "react-jsx"
// here would conflict with that pipeline.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "**/*.vue",
    "**/*.ts",
    "../../typecheck-shims/css.d.ts",
    "../../typecheck-shims/wa-pro-paths.d.ts"
  ]
}
