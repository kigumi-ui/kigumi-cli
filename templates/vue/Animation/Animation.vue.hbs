<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './Animation.css';

/**
 * Animate elements declaratively with nearly 100 baked-in presets, or roll your own with custom keyframes
 */
export interface AnimationProps {
  name?: string;
  play?: boolean;
  delay?: number;
  direction?: 'normal' | 'reverse' | 'alternate' | 'alternate-reverse';
  duration?: number;
  easing?: string;
  'end-delay'?: number;
  fill?: 'auto' | 'backwards' | 'both' | 'forwards' | 'none';
  iterations?: number;
  'iteration-start'?: number;
  'playback-rate'?: number;
}

const props = defineProps<AnimationProps>();

const emit = defineEmits<{
  'cancel': [event: CustomEvent];
  'finish': [event: CustomEvent];
  'start': [event: CustomEvent];
}>();

const elementRef = ref<HTMLElement | null>(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleCancel = (e: Event) => emit('cancel', e as CustomEvent);
  el.addEventListener('wa-cancel', handleCancel);
  const handleFinish = (e: Event) => emit('finish', e as CustomEvent);
  el.addEventListener('wa-finish', handleFinish);
  const handleStart = (e: Event) => emit('start', e as CustomEvent);
  el.addEventListener('wa-start', handleStart);

  onUnmounted(() => {
    el.removeEventListener('wa-cancel', handleCancel);
    el.removeEventListener('wa-finish', handleFinish);
    el.removeEventListener('wa-start', handleStart);
  });
});

defineExpose({
  cancel: () => (elementRef.value as any)?.cancel?.(),
  finish: () => (elementRef.value as any)?.finish?.(),
  element: elementRef,
});
</script>

<template>
  <wa-animation
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
  </wa-animation>
</template>
