<script setup>
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './TreeItem.css';

/**
 * Tree items are used inside trees to represent hierarchical items
 */
const props = defineProps({
    expanded: { type: Boolean, required: false, default: false },
    selected: { type: Boolean, required: false, default: false },
    disabled: { type: Boolean, required: false, default: false },
    lazy: { type: Boolean, required: false, default: false }
});

const emit = defineEmits(['expand', 'after-expand', 'collapse', 'after-collapse', 'lazy-change', 'lazy-load']);

const elementRef = ref(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleExpand = (e) => emit('expand', e);
  el.addEventListener('wa-expand', handleExpand);
  const handleAfterExpand = (e) => emit('after-expand', e);
  el.addEventListener('wa-after-expand', handleAfterExpand);
  const handleCollapse = (e) => emit('collapse', e);
  el.addEventListener('wa-collapse', handleCollapse);
  const handleAfterCollapse = (e) => emit('after-collapse', e);
  el.addEventListener('wa-after-collapse', handleAfterCollapse);
  const handleLazyChange = (e) => emit('lazy-change', e);
  el.addEventListener('wa-lazy-change', handleLazyChange);
  const handleLazyLoad = (e) => emit('lazy-load', e);
  el.addEventListener('wa-lazy-load', handleLazyLoad);

  onUnmounted(() => {
    el.removeEventListener('wa-expand', handleExpand);
    el.removeEventListener('wa-after-expand', handleAfterExpand);
    el.removeEventListener('wa-collapse', handleCollapse);
    el.removeEventListener('wa-after-collapse', handleAfterCollapse);
    el.removeEventListener('wa-lazy-change', handleLazyChange);
    el.removeEventListener('wa-lazy-load', handleLazyLoad);
  });
});

defineExpose({
  getChildrenItems: ({ includeDisabled = true }) => elementRef.value?.getChildrenItems?.({ includeDisabled = true }),
  element: elementRef,
});
</script>

<template>
  <wa-tree-item
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
    <slot name="expand-icon" />
    <slot name="collapse-icon" />
  </wa-tree-item>
</template>
