<script setup>
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './Dialog.css';

/**
 * Dialogs display important prompts and information
 */
const props = defineProps({
    open: { type: Boolean, required: false, default: false },
    label: { type: String, required: true, default: '' },
    'without-header': { type: Boolean, required: false, default: false },
    'light-dismiss': { type: Boolean, required: false, default: false }
});

const emit = defineEmits(['show', 'after-show', 'hide', 'after-hide']);

const elementRef = ref(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleShow = (e) => emit('show', e);
  el.addEventListener('wa-show', handleShow);
  const handleAfterShow = (e) => emit('after-show', e);
  el.addEventListener('wa-after-show', handleAfterShow);
  const handleHide = (e) => emit('hide', e);
  el.addEventListener('wa-hide', handleHide);
  const handleAfterHide = (e) => emit('after-hide', e);
  el.addEventListener('wa-after-hide', handleAfterHide);

  onUnmounted(() => {
    el.removeEventListener('wa-show', handleShow);
    el.removeEventListener('wa-after-show', handleAfterShow);
    el.removeEventListener('wa-hide', handleHide);
    el.removeEventListener('wa-after-hide', handleAfterHide);
  });
});

defineExpose({
  element: elementRef,
});
</script>

<template>
  <wa-dialog
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
    <slot name="label" />
    <slot name="header-actions" />
    <slot name="footer" />
  </wa-dialog>
</template>
