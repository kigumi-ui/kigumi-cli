<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './Dropdown.css';

/**
 * Dropdowns expose additional content that pops up when the user interacts with a trigger
 */
export interface DropdownProps {
  open?: boolean;
  placement?: 'top' | 'top-start' | 'top-end' | 'bottom' | 'bottom-start' | 'bottom-end' | 'right' | 'right-start' | 'right-end' | 'left' | 'left-start' | 'left-end';
  disabled?: boolean;
  'stay-open-on-select'?: boolean;
  distance?: number;
  skidding?: number;
  hoist?: boolean;
}

const props = defineProps<DropdownProps>();

const emit = defineEmits<{
  'show': [event: CustomEvent];
  'after-show': [event: CustomEvent];
  'hide': [event: CustomEvent];
  'after-hide': [event: CustomEvent];
  'select': [event: CustomEvent];
}>();

const elementRef = ref<HTMLElement | null>(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleShow = (e: Event) => emit('show', e as CustomEvent);
  el.addEventListener('wa-show', handleShow);
  const handleAfterShow = (e: Event) => emit('after-show', e as CustomEvent);
  el.addEventListener('wa-after-show', handleAfterShow);
  const handleHide = (e: Event) => emit('hide', e as CustomEvent);
  el.addEventListener('wa-hide', handleHide);
  const handleAfterHide = (e: Event) => emit('after-hide', e as CustomEvent);
  el.addEventListener('wa-after-hide', handleAfterHide);
  const handleSelect = (e: Event) => emit('select', e as CustomEvent);
  el.addEventListener('wa-select', handleSelect);

  onUnmounted(() => {
    el.removeEventListener('wa-show', handleShow);
    el.removeEventListener('wa-after-show', handleAfterShow);
    el.removeEventListener('wa-hide', handleHide);
    el.removeEventListener('wa-after-hide', handleAfterHide);
    el.removeEventListener('wa-select', handleSelect);
  });
});

defineExpose({
  element: elementRef,
});
</script>

<template>
  <wa-dropdown
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
    <slot name="trigger" />
  </wa-dropdown>
</template>
