<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './Select.css';

/**
 * Selects allow you to choose items from a menu of predefined options
 */
export interface SelectProps {
  name?: string;
  value?: string;
  appearance?: 'filled' | 'outlined' | 'filled-outlined';
  size?: 'small' | 'medium' | 'large';
  placeholder?: string;
  multiple?: boolean;
  'max-options-visible'?: number;
  disabled?: boolean;
  'with-clear'?: boolean;
  open?: boolean;
  hoist?: boolean;
  placement?: 'top' | 'bottom';
  pill?: boolean;
  label?: string;
  hint?: string;
  required?: boolean;
}

const props = defineProps<SelectProps>();

const emit = defineEmits<{
  'input': [event: CustomEvent];
  'change': [event: CustomEvent];
  'focus': [event: FocusEvent];
  'blur': [event: CustomEvent];
  'clear': [event: CustomEvent];
  'show': [event: CustomEvent];
  'after-show': [event: CustomEvent];
  'hide': [event: CustomEvent];
  'after-hide': [event: CustomEvent];
  'invalid': [event: CustomEvent];
}>();

const elementRef = ref<HTMLElement | null>(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleInput = (e: Event) => emit('input', e as CustomEvent);
  el.addEventListener('input', handleInput);
  const handleChange = (e: Event) => emit('change', e as CustomEvent);
  el.addEventListener('change', handleChange);
  const handleFocus = (e: Event) => emit('focus', e as FocusEvent);
  el.addEventListener('focus', handleFocus);
  const handleBlur = (e: Event) => emit('blur', e as CustomEvent);
  el.addEventListener('blur', handleBlur);
  const handleClear = (e: Event) => emit('clear', e as CustomEvent);
  el.addEventListener('wa-clear', handleClear);
  const handleShow = (e: Event) => emit('show', e as CustomEvent);
  el.addEventListener('wa-show', handleShow);
  const handleAfterShow = (e: Event) => emit('after-show', e as CustomEvent);
  el.addEventListener('wa-after-show', handleAfterShow);
  const handleHide = (e: Event) => emit('hide', e as CustomEvent);
  el.addEventListener('wa-hide', handleHide);
  const handleAfterHide = (e: Event) => emit('after-hide', e as CustomEvent);
  el.addEventListener('wa-after-hide', handleAfterHide);
  const handleInvalid = (e: Event) => emit('invalid', e as CustomEvent);
  el.addEventListener('wa-invalid', handleInvalid);

  onUnmounted(() => {
    el.removeEventListener('input', handleInput);
    el.removeEventListener('change', handleChange);
    el.removeEventListener('focus', handleFocus);
    el.removeEventListener('blur', handleBlur);
    el.removeEventListener('wa-clear', handleClear);
    el.removeEventListener('wa-show', handleShow);
    el.removeEventListener('wa-after-show', handleAfterShow);
    el.removeEventListener('wa-hide', handleHide);
    el.removeEventListener('wa-after-hide', handleAfterHide);
    el.removeEventListener('wa-invalid', handleInvalid);
  });
});

defineExpose({
  show: () => (elementRef.value as any)?.show?.(),
  hide: () => (elementRef.value as any)?.hide?.(),
  focus: (options: FocusOptions) => (elementRef.value as any)?.focus?.(options),
  blur: () => (elementRef.value as any)?.blur?.(),
  element: elementRef,
});
</script>

<template>
  <wa-select
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
    <slot name="label" />
    <slot name="start" />
    <slot name="end" />
    <slot name="clear-icon" />
    <slot name="expand-icon" />
    <slot name="hint" />
  </wa-select>
</template>
