<script setup lang="ts">
import { ref } from 'vue';
import '{{{importPath}}}';
import './LineChart.css';

/**
 * Connects sequential data points to reveal trends and patterns over a continuous axis
 */
export interface LineChartProps {
  label?: string;
  description?: string;
  'legend-position'?: 'top' | 'right' | 'bottom' | 'left' | 'start' | 'end';
  'without-animation'?: boolean;
  'without-legend'?: boolean;
  'without-tooltip'?: boolean;
  'x-label'?: string;
  'y-label'?: string;
  stacked?: boolean;
  'index-axis'?: 'x' | 'y';
  grid?: 'x' | 'y' | 'both' | 'none';
  min?: number;
  max?: number;
}

const props = defineProps<LineChartProps>();

const elementRef = ref<HTMLElement | null>(null);

defineExpose({
  element: elementRef,
});
</script>

<template>
  <wa-line-chart
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
  </wa-line-chart>
</template>
