<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue';
import '{{{importPath}}}';
import './Icon.css';

/**
 * Icons are symbols that can be used to represent various options within an application
 */
export interface IconProps {
  name?: string;
  library?: string;
  src?: string;
  label?: string;
  family?: string;
  variant?: string;
  'auto-width'?: boolean;
  'swap-opacity'?: boolean;
}

const props = defineProps<IconProps>();

const emit = defineEmits<{
  'load': [event: CustomEvent];
  'error': [event: CustomEvent];
}>();

const elementRef = ref<HTMLElement | null>(null);

onMounted(() => {
  const el = elementRef.value;
  if (!el) return;

  const handleLoad = (e: Event) => emit('load', e as CustomEvent);
  el.addEventListener('wa-load', handleLoad);
  const handleError = (e: Event) => emit('error', e as CustomEvent);
  el.addEventListener('wa-error', handleError);

  onUnmounted(() => {
    el.removeEventListener('wa-load', handleLoad);
    el.removeEventListener('wa-error', handleError);
  });
});

defineExpose({
  element: elementRef,
});
</script>

<template>
  <wa-icon
    ref="elementRef"
    v-bind="props"
    :class="$attrs.class"
  >
    <slot />
  </wa-icon>
</template>
