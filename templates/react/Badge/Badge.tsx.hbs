import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Badge.css';

/**
 * Badges are used to draw attention and display statuses or counts
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Badge>New</Badge>
 *
 * // With start/end slots
 * <Badge variant="success">
 *   <wa-icon slot="start" name="check" />
 *   Approved
 * </Badge>
 *
 * // Pill style with attention
 * <Badge pill attention="pulse">5</Badge>
 * ```
 */
export interface BadgeProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The badge's theme variant */
  variant?: 'brand' | 'neutral' | 'success' | 'warning' | 'danger';

  /** The badge's visual appearance */
  appearance?: 'accent' | 'filled' | 'outlined' | 'filled-outlined';

  /** Draws a pill-style badge with rounded edges */
  pill?: boolean;

  /** Adds an animation to draw attention to the badge */
  attention?: 'none' | 'pulse' | 'bounce';
}

/**
 * Ref type: `ref.current` is the underlying `<wa-badge>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type BadgeRef = WaElement;

export const Badge = forwardRef<WaElement, BadgeProps>(
  ({ children, className, ...props }, ref) => (
    <wa-badge
      ref={ref}
      class={clsx('Badge', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-badge>
  )
);

Badge.displayName = 'Badge';
