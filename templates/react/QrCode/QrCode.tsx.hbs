import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './QrCode.css';

/**
 * Generates QR codes for encoding text, URLs, or data
 *
 * @example
 * ```tsx
 * // Basic usage
 * <QrCode />
 *
 * // With event handlers
 * <QrCode />
 *
 * ```
 */
export interface QrCodeProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The data to encode */
  value?: string;

  /** Accessible label */
  label?: string;

  /** Size in pixels */
  size?: number;

  /** Fill color */
  fill?: string;

  /** Background color */
  background?: string;

  /** Corner radius */
  radius?: number;

  /** Error correction level */
  'error-correction'?: 'L' | 'M' | 'Q' | 'H';
}

/**
 * Ref type: `ref.current` is the underlying `<wa-qr-code>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type QrCodeRef = WaElement;

export const QrCode = forwardRef<WaElement, QrCodeProps>(
  ({ children, className, ...props }, ref) => (
    <wa-qr-code
      ref={ref}
      class={clsx('QrCode', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-qr-code>
  )
);

QrCode.displayName = 'QrCode';
