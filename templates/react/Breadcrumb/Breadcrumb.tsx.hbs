import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Breadcrumb.css';

/**
 * Breadcrumbs provide a group of links so users can easily navigate a website hierarchy
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Breadcrumb />
 *
 * // With event handlers
 * <Breadcrumb />
 *
 * ```
 */
export interface BreadcrumbProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The label to use for the breadcrumb control for assistive devices */
  label?: string;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-breadcrumb>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type BreadcrumbRef = WaElement;

export const Breadcrumb = forwardRef<WaElement, BreadcrumbProps>(
  ({ children, className, ...props }, ref) => (
    <wa-breadcrumb
      ref={ref}
      class={clsx('Breadcrumb', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-breadcrumb>
  )
);

Breadcrumb.displayName = 'Breadcrumb';
