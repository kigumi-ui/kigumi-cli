import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './FormatBytes.css';

/**
 * Formats a number as a human-readable byte value
 *
 * @example
 * ```tsx
 * // Basic usage
 * <FormatBytes />
 *
 * // With event handlers
 * <FormatBytes />
 *
 * ```
 */
export interface FormatBytesProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The number to format in bytes */
  value?: number;

  /** The unit to format the value in */
  unit?: 'byte' | 'bit';

  /** Determines how to display the result */
  display?: 'long' | 'short' | 'narrow';

  /** The locale to use when formatting */
  lang?: string;

  /** Alias for lang */
  locale?: string;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-format-bytes>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type FormatBytesRef = WaElement;

export const FormatBytes = forwardRef<WaElement, FormatBytesProps>(
  ({ children, className, locale, ...props }, ref) => {
    const passThrough = {
      ...props,
      ...(locale !== undefined && { lang: locale }),
    };
    return (
      <wa-format-bytes
        ref={ref}
        class={clsx('FormatBytes', className)}
        {...(passThrough as Record<string, unknown>)}
      >
        {children}
      </wa-format-bytes>
    );
  }
);

FormatBytes.displayName = 'FormatBytes';
