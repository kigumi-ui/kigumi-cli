import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Scroller.css';

/**
 * Adds a scrollable container with optional shadow indicators
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Scroller />
 *
 * // With event handlers
 * <Scroller />
 *
 * ```
 */
export interface ScrollerProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** Scroll direction */
  orientation?: 'horizontal' | 'vertical' | 'both';

  /** Shows shadow indicators */
  'with-scroll-indicator'?: boolean;

  /** Hides the scrollbar */
  'without-scrollbar'?: boolean;

  /** Hides shadow indicators */
  'without-shadow'?: boolean;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-scroller>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type ScrollerRef = WaElement;

export const Scroller = forwardRef<WaElement, ScrollerProps>(
  ({ children, className, ...props }, ref) => (
    <wa-scroller
      ref={ref}
      class={clsx('Scroller', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-scroller>
  )
);

Scroller.displayName = 'Scroller';
