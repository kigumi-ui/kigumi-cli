import { render } from '@testing-library/react';
import { AnimatedImage } from './AnimatedImage';

describe('AnimatedImage', () => {
  it('renders without crashing', () => {
    const { container } = render(<AnimatedImage src="test.gif" alt="Test" />);
    expect(container.querySelector('wa-animated-image')).toBeInTheDocument();
  });

  it('applies custom className', () => {
    const { container } = render(<AnimatedImage src="test.gif" alt="Test" className="custom-class" />);
    expect(container.querySelector('.custom-class')).toBeInTheDocument();
  });
});
