import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Markdown.css';

/**
 * Renders markdown content in plain HTML
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Markdown>
 *   <script type="text/markdown"># Hello World</script>
 * </Markdown>
 *
 * // With tab size
 * <Markdown tab-size={2}>
 *   <script type="text/markdown">	Indented content</script>
 * </Markdown>
 *
 * // With ref methods
 * const ref = useRef<MarkdownRef>(null);
 * <button onClick={() => ref.current?.renderMarkdown()}>Re-render</button>
 * <Markdown ref={ref}>
 *   <script type="text/markdown"># Hello</script>
 * </Markdown>
 * ```
 */
export interface MarkdownProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {
  /** Tab stop width for whitespace normalization */
  'tab-size'?: number;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-markdown>` element.
 * (Before v0.20 this was `{ element: WaElement | null }` with `renderMarkdown`, `getMarked`,
 * and `updateAll` methods; call those directly on `ref.current` instead.)
 */
export type MarkdownRef = WaElement;

export const Markdown = forwardRef<WaElement, MarkdownProps>(
  ({ children, className, ...props }, ref) => (
    <wa-markdown
      ref={ref}
      class={clsx('Markdown', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-markdown>
  )
);

Markdown.displayName = 'Markdown';
