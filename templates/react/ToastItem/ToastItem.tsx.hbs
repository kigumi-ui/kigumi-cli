'use client';

import { forwardRef, useRef, useImperativeHandle, useEffect, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './ToastItem.css';

/**
 * A single notification banner that can be stacked inside a Toast container
 *
 * @example
 * ```tsx
 * // Basic usage inside a Toast
 * <Toast>
 *   <ToastItem variant="success">File saved successfully!</ToastItem>
 * </Toast>
 *
 * // With icon and custom duration
 * <ToastItem variant="danger" duration={10000}>
 *   <wa-icon slot="icon" name="triangle-exclamation" />
 *   Something went wrong
 * </ToastItem>
 *
 * // With ref to hide programmatically
 * const itemRef = useRef<ToastItemRef>(null);
 * <ToastItem ref={(el: WaElement | null) => { itemRef.current = el; }}>
 *   Dismissible notification
 * </ToastItem>
 * ```
 */
export interface ToastItemProps extends Omit<HTMLAttributes<HTMLElement>, 'onShow' | 'onHide' | 'dir'> {

  /** Colour scheme reflecting the notification intent */
  variant?: 'brand' | 'success' | 'warning' | 'danger' | 'neutral';

  /** Controls the overall dimensions of the notification */
  size?: 'small' | 'medium' | 'large';

  /** Milliseconds before auto-dismiss. Use 0 to keep it visible until closed. */
  duration?: number;

  /** Fires when the reveal transition starts. */
  onShow?: (event: CustomEvent) => void;

  /** Fires once the reveal transition has finished. */
  onAfterShow?: (event: CustomEvent) => void;

  /** Fires when the dismiss transition starts. */
  onHide?: (event: CustomEvent) => void;

  /** Fires once the dismiss transition has finished. */
  onAfterHide?: (event: CustomEvent) => void;
}

export interface ToastItemRef {
  /** Hides the toast item with animation and removes it from the DOM */
  hide: () => void;
  /** Reference to the underlying element */
  element: WaElement | null;
}

export const ToastItem = forwardRef<ToastItemRef, ToastItemProps>(
  ({ children, className, onShow, onAfterShow, onHide, onAfterHide, ...props }, ref) => {
    const toastItemRef = useRef<WaElement | null>(null);

    useImperativeHandle(
      ref,
      () => ({
        hide: () => toastItemRef.current?.hide?.(),
        get element() {
          return toastItemRef.current;
        },
      }),
      []
    );

    useEffect(() => {
      const el = toastItemRef.current;
      if (!el) return;
      const htmlEl = el as unknown as HTMLElement;

      const handleShow = (e: Event) => onShow?.(e as CustomEvent);
      const handleAfterShow = (e: Event) => onAfterShow?.(e as CustomEvent);
      const handleHide = (e: Event) => onHide?.(e as CustomEvent);
      const handleAfterHide = (e: Event) => onAfterHide?.(e as CustomEvent);

      htmlEl.addEventListener('wa-show', handleShow);
      htmlEl.addEventListener('wa-after-show', handleAfterShow);
      htmlEl.addEventListener('wa-hide', handleHide);
      htmlEl.addEventListener('wa-after-hide', handleAfterHide);

      return () => {
        htmlEl.removeEventListener('wa-show', handleShow);
        htmlEl.removeEventListener('wa-after-show', handleAfterShow);
        htmlEl.removeEventListener('wa-hide', handleHide);
        htmlEl.removeEventListener('wa-after-hide', handleAfterHide);
      };
    }, [onShow, onAfterShow, onHide, onAfterHide]);

    return (
      <wa-toast-item
        ref={(el: WaElement | null) => { toastItemRef.current = el; }}
        class={clsx('ToastItem', className)}
        {...(props as Record<string, unknown>)}
      >
        {children}
      </wa-toast-item>
    );
  }
);

ToastItem.displayName = 'ToastItem';
