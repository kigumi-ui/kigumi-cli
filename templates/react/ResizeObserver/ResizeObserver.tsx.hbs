import { forwardRef, useRef, useImperativeHandle, useEffect, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import './ResizeObserver.css';

/**
 * Reports changes to the dimensions of an element
 *
 * @example
 * ```tsx
 * // Basic usage
 * <ResizeObserver />
 *
 * // With event handlers
 * <ResizeObserver
 *   onWaResize={(e) => console.log(e)} />
 *
 * ```
 */
export interface ResizeObserverProps extends Omit<HTMLAttributes<HTMLElement>, 'onWaResize' | 'dir'> {

  /** Disables the observer */
  disabled?: boolean;

  /** Emitted when the element is resized. */
  onWaResize?: (event: CustomEvent) => void;
}

export interface ResizeObserverRef {
  /** Reference to the underlying HTML element */
  element: HTMLElement | null;
}

export const ResizeObserver = forwardRef<ResizeObserverRef, ResizeObserverProps>(
  ({ children, className, onWaResize, ...props }, ref) => {
    const resizeobserverRef = useRef<HTMLElement & {
    }>(null);

    useImperativeHandle(
      ref,
      () => ({
        get element() {
          return resizeobserverRef.current;
        },
      }),
      []
    );

    useEffect(() => {
      const el = resizeobserverRef.current;
      if (!el) return;

      const handleWaResize = (e: Event) => {
        if (onWaResize) onWaResize(e as CustomEvent);
      };

      el.addEventListener('wa-resize', handleWaResize);

      return () => {
        el.removeEventListener('wa-resize', handleWaResize);
      };
    }, [onWaResize]);

    return (
      <wa-resize-observer
        ref={resizeobserverRef}
        class={clsx('ResizeObserver', className)}
        {...(props as Record<string, unknown>)}
      >
        {children}
      </wa-resize-observer>
    );
  }
);

ResizeObserver.displayName = 'ResizeObserver';
