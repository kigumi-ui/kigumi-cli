import { forwardRef, useRef, useImperativeHandle, useEffect, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import './Slider.css';

export interface SliderProps extends Omit<HTMLAttributes<HTMLElement>, 'onChange' | 'onInvalid' | 'dir'> {
  /** The slider's label */
  label?: string;
  /** Name for form submission */
  name?: string;
  /** Current value */
  value?: number;
  /** Minimum value */
  min?: number;
  /** Maximum value */
  max?: number;
  /** Step increment */
  step?: number;
  /** The slider's size */
  size?: 'small' | 'medium' | 'large';
  /** The orientation of the slider */
  orientation?: 'horizontal' | 'vertical';
  /** Disables the slider */
  disabled?: boolean;
  /** Makes the slider readonly */
  readonly?: boolean;
  /** Makes the slider required */
  required?: boolean;
  /** Converts to a range slider */
  range?: boolean;
  /** Draws markers at each step */
  'with-markers'?: boolean;
  /** Draws a tooltip above the thumb */
  'with-tooltip'?: boolean;
  /** Hint text */
  hint?: string;
  /** Event fired when value changes */
  onChange?: (event: Event) => void;
  /** Event fired when validation fails */
  onInvalid?: (event: CustomEvent) => void;
}

export interface SliderRef {
  focus: (options?: FocusOptions) => void;
  blur: () => void;
  stepUp: () => void;
  stepDown: () => void;
  element: HTMLElement | null;
}

export const Slider = forwardRef<SliderRef, SliderProps>(
  ({ className, onChange, onInvalid, ...props }, ref) => {
    const sliderRef = useRef<HTMLElement & {
      focus?: (options?: FocusOptions) => void;
      blur?: () => void;
      stepUp?: () => void;
      stepDown?: () => void;
    }>(null);

    useImperativeHandle(
      ref,
      () => ({
        focus: (options) => sliderRef.current?.focus?.(options),
        blur: () => sliderRef.current?.blur?.(),
        stepUp: () => sliderRef.current?.stepUp?.(),
        stepDown: () => sliderRef.current?.stepDown?.(),
        get element() {
          return sliderRef.current;
        },
      }),
      []
    );

    useEffect(() => {
      const el = sliderRef.current;
      if (!el) return;

      const handleChange = (e: Event) => onChange?.(e);
      const handleInvalid = (e: Event) => onInvalid?.(e as CustomEvent);

      el.addEventListener('change', handleChange);
      el.addEventListener('wa-invalid', handleInvalid);

      return () => {
        el.removeEventListener('change', handleChange);
        el.removeEventListener('wa-invalid', handleInvalid);
      };
    }, [onChange, onInvalid]);

    return (
      <wa-slider
        ref={sliderRef}
        class={clsx('Slider', className)}
        {...(props as Record<string, unknown>)}
      />
    );
  }
);

Slider.displayName = 'Slider';
