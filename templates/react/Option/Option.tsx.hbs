import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Option.css';

/**
 * Options define the selectable items within various form controls
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Option />
 *
 * // With event handlers
 * <Option />
 *
 * ```
 */
export interface OptionProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The option value */
  value?: string;

  /** Disables the option */
  disabled?: boolean;

  /** Draws the option in a selected state */
  selected?: boolean;

  /** A custom label for the option (used by select's display input) */
  label?: string;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-option>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type OptionRef = WaElement;

export const Option = forwardRef<WaElement, OptionProps>(
  ({ children, className, ...props }, ref) => (
    <wa-option
      ref={ref}
      class={clsx('Option', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-option>
  )
);

Option.displayName = 'Option';
