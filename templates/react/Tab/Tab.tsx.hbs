import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Tab.css';

/**
 * Tabs are used inside tab groups to represent selectable tabs
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Tab />
 *
 * // With event handlers
 * <Tab />
 *
 * ```
 */
export interface TabProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** Associated panel name */
  panel?: string;

  /** Disables the tab */
  disabled?: boolean;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-tab>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type TabRef = WaElement;

export const Tab = forwardRef<WaElement, TabProps>(
  ({ children, className, ...props }, ref) => (
    <wa-tab
      ref={ref}
      class={clsx('Tab', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-tab>
  )
);

Tab.displayName = 'Tab';
