import { forwardRef, useRef, useImperativeHandle, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import './Tab.css';

/**
 * Tabs are used inside tab groups to represent selectable tabs
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Tab />
 *
 * // With event handlers
 * <Tab />
 *
 * ```
 */
export interface TabProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** Associated panel name */
  panel?: string;

  /** Disables the tab */
  disabled?: boolean;
}

export interface TabRef {
  /** Reference to the underlying HTML element */
  element: HTMLElement | null;
}

export const Tab = forwardRef<TabRef, TabProps>(
  ({ children, className, ...props }, ref) => {
    const tabRef = useRef<HTMLElement & {
    }>(null);

    useImperativeHandle(
      ref,
      () => ({
        get element() {
          return tabRef.current;
        },
      }),
      []
    );

    return (
      <wa-tab
        ref={tabRef}
        class={clsx('Tab', className)}
        {...(props as Record<string, unknown>)}
      >
        {children}
      </wa-tab>
    );
  }
);

Tab.displayName = 'Tab';
