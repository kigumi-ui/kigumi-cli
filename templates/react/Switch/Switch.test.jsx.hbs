import { describe, it, expect } from 'vitest';
import { render } from '@testing-library/react';
import React from 'react';
import { Switch } from './Switch';

describe('Switch', () => {
  it('renders without crashing', () => {
    const { container } = render(<Switch>Toggle me</Switch>);
    expect(container.querySelector('wa-switch')).toBeInTheDocument();
  });

  it('exposes ref methods', () => {
    const ref = React.createRef();
    render(<Switch ref={ref}>Toggle me</Switch>);
    expect(ref.current).toHaveProperty('focus');
    expect(ref.current).toHaveProperty('blur');
    expect(ref.current).toHaveProperty('click');
  });
});
