import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './CarouselItem.css';

/**
 * Represents an individual slide within a carousel component
 *
 * @example
 * ```tsx
 * // Basic usage
 * <CarouselItem />
 *
 * // With event handlers
 * <CarouselItem />
 *
 * ```
 */
export type CarouselItemProps = Omit<HTMLAttributes<HTMLElement>, 'dir'>;

/**
 * Ref type: `ref.current` is the underlying `<wa-carousel-item>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type CarouselItemRef = WaElement;

export const CarouselItem = forwardRef<WaElement, CarouselItemProps>(
  ({ children, className, ...props }, ref) => (
    <wa-carousel-item
      ref={ref}
      class={clsx('CarouselItem', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-carousel-item>
  )
);

CarouselItem.displayName = 'CarouselItem';
