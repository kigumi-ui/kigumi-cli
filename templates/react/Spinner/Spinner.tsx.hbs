import { forwardRef, useRef, useImperativeHandle, useEffect, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import './Spinner.css';

let loadPromise: Promise<unknown> | null = null;
function ensureLoaded() {
  return (loadPromise ??= import('{{{importPath}}}'));
}

/**
 * Spinners are used to show the progress of an indeterminate operation
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Spinner />
 *
 * // With event handlers
 * <Spinner />
 *
 * ```
 */
export interface SpinnerProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

}

export interface SpinnerRef {
  /** Reference to the underlying HTML element */
  element: HTMLElement | null;
}

export const Spinner = forwardRef<SpinnerRef, SpinnerProps>(
  ({ children, className, ...props }, ref) => {
    const spinnerRef = useRef<HTMLElement & {
    }>(null);

    useImperativeHandle(
      ref,
      () => ({
        get element() {
          return spinnerRef.current;
        },
      }),
      []
    );

    useEffect(() => {
      ensureLoaded();
    }, []);

    return (
      <wa-spinner
        ref={spinnerRef}
        class={clsx('Spinner', className)}
        suppressHydrationWarning
        {...(props as Record<string, unknown>)}
      >
        {children}
      </wa-spinner>
    );
  }
);

Spinner.displayName = 'Spinner';
