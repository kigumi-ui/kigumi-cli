import { forwardRef, useRef, useImperativeHandle, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './TabPanel.css';

/**
 * Tab panels are used inside tab groups to display content for each tab
 *
 * @example
 * ```tsx
 * // Basic usage
 * <TabPanel />
 *
 * // With event handlers
 * <TabPanel />
 *
 * ```
 */
export interface TabPanelProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The panel name */
  name?: string;

  /** Whether the panel is shown */
  active?: boolean;
}

export interface TabPanelRef {
  /** Reference to the underlying element */
  element: WaElement | null;
}

export const TabPanel = forwardRef<TabPanelRef, TabPanelProps>(
  ({ children, className, ...props }, ref) => {
    const tabpanelRef = useRef<WaElement | null>(null);

    useImperativeHandle(
      ref,
      () => ({
        get element() {
          return tabpanelRef.current;
        },
      }),
      []
    );

    return (
      <wa-tab-panel
        ref={(el: WaElement | null) => { tabpanelRef.current = el; }}
        class={clsx('TabPanel', className)}
        {...(props as Record<string, unknown>)}
      >
        {children}
      </wa-tab-panel>
    );
  }
);

TabPanel.displayName = 'TabPanel';
