import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './TabPanel.css';

/**
 * Tab panels are used inside tab groups to display content for each tab
 *
 * @example
 * ```tsx
 * // Basic usage
 * <TabPanel />
 *
 * // With event handlers
 * <TabPanel />
 *
 * ```
 */
export interface TabPanelProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** The panel name */
  name?: string;

  /** Whether the panel is shown */
  active?: boolean;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-tab-panel>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type TabPanelRef = WaElement;

export const TabPanel = forwardRef<WaElement, TabPanelProps>(
  ({ children, className, ...props }, ref) => (
    <wa-tab-panel
      ref={ref}
      class={clsx('TabPanel', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-tab-panel>
  )
);

TabPanel.displayName = 'TabPanel';
