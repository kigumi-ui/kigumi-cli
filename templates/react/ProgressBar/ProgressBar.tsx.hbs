import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './ProgressBar.css';

/**
 * Progress bars are used to show the completion of a task or operation
 *
 * @example
 * ```tsx
 * // Basic usage
 * <ProgressBar />
 *
 * // With event handlers
 * <ProgressBar />
 *
 * ```
 */
export interface ProgressBarProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** Current progress (0-100) */
  value?: number;

  /** Shows indeterminate state */
  indeterminate?: boolean;

  /** Accessible label */
  label?: string;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-progress-bar>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type ProgressBarRef = WaElement;

export const ProgressBar = forwardRef<WaElement, ProgressBarProps>(
  ({ children, className, ...props }, ref) => (
    <wa-progress-bar
      ref={ref}
      class={clsx('ProgressBar', className)}
      {...(props as Record<string, unknown>)}
    >
      {children}
    </wa-progress-bar>
  )
);

ProgressBar.displayName = 'ProgressBar';
