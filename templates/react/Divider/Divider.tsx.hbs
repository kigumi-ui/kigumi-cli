import { forwardRef, type HTMLAttributes } from 'react';
import clsx from 'clsx';
import '{{{importPath}}}';
import type WaElement from '{{{importPath}}}';
import './Divider.css';

/**
 * Dividers are used to visually separate content
 *
 * @example
 * ```tsx
 * // Basic usage
 * <Divider />
 *
 * // With event handlers
 * <Divider />
 *
 * ```
 */
export interface DividerProps extends Omit<HTMLAttributes<HTMLElement>, 'dir'> {

  /** Divider orientation */
  orientation?: 'horizontal' | 'vertical';

  /** Alias for orientation="vertical" */
  vertical?: boolean;
}

/**
 * Ref type: `ref.current` is the underlying `<wa-divider>` element.
 * (Before v0.20 this was `{ element: WaElement | null }`; use
 * `ref.current` directly instead of `ref.current.element`.)
 */
export type DividerRef = WaElement;

export const Divider = forwardRef<WaElement, DividerProps>(
  ({ children, className, vertical, ...props }, ref) => {
    const passThrough = {
      ...props,
      ...(vertical !== undefined && { orientation: vertical ? 'vertical' : 'horizontal' }),
    };
    return (
      <wa-divider
        ref={ref}
        class={clsx('Divider', className)}
        {...(passThrough as Record<string, unknown>)}
      >
        {children}
      </wa-divider>
    );
  }
);

Divider.displayName = 'Divider';
