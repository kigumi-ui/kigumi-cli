{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "tests/**/*",
    "src/**/*",
    "typecheck-shims/css.d.ts",
    "typecheck-shims/react-jsx.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/lib/**",
    "tests/.tmp-*/**",
    "tests/test-*/**",
    "tests/react*/**",
    "tests/fixtures/starter-snapshots/**"
  ]
}
