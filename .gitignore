node_modules/
dist/
*.log
.DS_Store
.env
.env.local
coverage/
coverage-merged/
*.tsbuildinfo

# npm/pnpm pack tarballs (e.g. release smoke test) - must never be committed,
# the changesets action stages the working tree with `git add .`
*.tgz
.pnpm-store/
tests/.tmp-*

# Allow npm users to work locally, but only commit pnpm lock
docs/package-lock.json
temp/

# Generated validation/transformation results
transform-results.json
validation-results.json

# Copied at docs build time (prebuild)
docs/public/.well-known/skills/

# Maintenance-only audit utilities (not for distribution)
audit/

# Claude Code scratch state
.claude/plans/
.claude/specs/
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Internal engineering process notes (specs, plans, initiative state)
docs/superpowers/

# Working temp directory for one-shot scripts
tmp/

# Stryker mutation testing
.stryker-tmp/
reports/mutation/

graphify-out/cost.json        # local only
graphify-out/cache/         # optional: commit for speed, skip to keep repo small
graphify-out/.graphify_analysis.json    # local working state (clustering intermediate)
graphify-out/.graphify_labels.json.sig  # local working state (label integrity signature)
graphify-out/.graphify_python           # local working state (interpreter path)
graphify-out/.graphify_root             # local working state (scan root)
