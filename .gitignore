node_modules/
dist/
*.log
.DS_Store
.env
.env.local
coverage/
coverage-merged/
*.tsbuildinfo

# npm/pnpm pack tarballs (e.g. release smoke test) - must never be committed,
# the changesets action stages the working tree with `git add .`
*.tgz
.pnpm-store/
tests/.tmp-*

# Allow npm users to work locally, but only commit pnpm lock
docs/package-lock.json
temp/

# Generated validation/transformation results
transform-results.json
validation-results.json

# Copied at docs build time (prebuild)
docs/public/.well-known/skills/

# Maintenance-only audit utilities (not for distribution)
audit/

# Claude Code scratch state
.claude/plans/
.claude/specs/
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/reports/

# Internal engineering process notes (specs, plans, initiative state)
docs/superpowers/

# Working temp directory for one-shot scripts
tmp/

# Stryker mutation testing
.stryker-tmp/
reports/mutation/

# .husky/.graphify-python: the interpreter path recorded at hook-install time.
# Local only, because an interpreter path contains the developer's home
# directory and this repo is public.
.husky/.graphify-python

# graphify-out/: generated knowledge-graph artifacts, local only.
# Regenerate with /graphify; the dumps are multi-MB and go stale immediately.
graphify-out/
