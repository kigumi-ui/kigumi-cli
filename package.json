{
  "name": "kigumi",
  "version": "0.6.1",
  "description": "CLI tool to add Web Awesome components to your project",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "bin": {
    "kigumi": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "llms.txt",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Siregar/kigumi-cli.git"
  },
  "homepage": "https://kigumi.style",
  "bugs": {
    "url": "https://github.com/Siregar/kigumi-cli/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate:metadata": "tsx scripts/parse-custom-elements.ts",
    "prebuild": "pnpm generate:metadata",
    "build:skills": "tsx scripts/generate-skill-references.ts && cp -r skills dist/",
    "build": "tsup src/index.ts --format esm --dts && cp -r templates dist/ && pnpm build:skills && cp llms.txt dist/",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.ts",
    "test:e2e": "vitest run tests/e2e --testTimeout=300000",
    "test:all": "vitest run",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "validate:changes": "tsx scripts/validate-changes.ts",
    "validate:all": "pnpm validate:registry && pnpm validate:templates && pnpm validate:changes",
    "verify:app": "tsx scripts/verify-test-app.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "web-awesome",
    "components",
    "cli",
    "react",
    "vue",
    "ui"
  ],
  "author": "Michael Suzuki <legal@kigumi.style>",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cheerio": "^1.2.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.0.0",
    "ts-morph": "^27.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  }
}
