{
  "name": "kigumi",
  "version": "0.19.2",
  "description": "CLI tool to add Web Awesome components to your project",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "bin": {
    "kigumi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "llms.txt",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Siregar/kigumi-cli.git"
  },
  "homepage": "https://kigumi.style",
  "bugs": {
    "url": "https://github.com/Siregar/kigumi-cli/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "setup:npmrc": "node scripts/setup-npmrc.mjs",
    "dev": "tsx watch src/index.ts",
    "generate:metadata": "tsx scripts/parse-custom-elements.ts",
    "generate:skill-refs": "tsx scripts/generate-skill-references.ts",
    "prebuild": "test -f src/utils/component-metadata.ts || pnpm generate:metadata",
    "build": "tsup && tsx scripts/post-build.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run tests/unit --config vitest.unit.config.ts",
    "test:coverage": "vitest run tests/unit --config vitest.unit.config.ts --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.ts",
    "test:e2e": "vitest run tests/e2e --testTimeout=300000",
    "test:all": "vitest run",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "validate:changes": "tsx scripts/validate-changes.ts",
    "validate:stories": "tsx scripts/storybook/validate-stories.ts",
    "validate:cem-sync": "tsx scripts/validate-cem-sync.ts",
    "validate:parity": "tsx scripts/validate-parity.ts",
    "validate:agents": "tsx scripts/validate-agents.ts",
    "generate:stories": "tsx scripts/storybook/patch-stories.ts",
    "validate:all": "pnpm validate:registry && pnpm validate:templates && pnpm validate:changes && pnpm validate:stories && pnpm validate:cem-sync && pnpm validate:parity && pnpm validate:agents",
    "verify:app": "tsx scripts/verify-test-app.ts",
    "lint": "eslint src tests templates",
    "lint:fix": "eslint src tests templates --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version && tsx scripts/post-changeset-version.ts",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "web-awesome",
    "components",
    "cli",
    "react",
    "vue",
    "ui"
  ],
  "author": "Michael Suzuki <legal@kigumi.style>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.2.0",
    "node-diff3": "^3.2.0",
    "picocolors": "^1.0.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  }
}
