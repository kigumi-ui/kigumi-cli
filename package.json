{
  "name": "kigumi",
  "version": "0.24.0",
  "description": "CLI tool to add Web Awesome components to your project",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "bin": {
    "kigumi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "llms.txt",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Siregar/kigumi-cli.git"
  },
  "homepage": "https://kigumi.style",
  "bugs": {
    "url": "https://github.com/Siregar/kigumi-cli/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "setup:npmrc": "node scripts/setup-npmrc.mjs",
    "dev": "tsx watch src/index.ts",
    "generate:metadata": "tsx scripts/parse-custom-elements.ts",
    "generate:skill-refs": "tsx scripts/generate-skill-references.ts",
    "generate:react": "tsx scripts/generate-react-templates.ts",
    "generate:vue": "tsx scripts/generate-vue-templates.ts",
    "generate:angular": "tsx scripts/generate-angular-templates.ts",
    "generate:templates": "pnpm generate:react && pnpm generate:vue && pnpm generate:angular",
    "prebuild": "tsx scripts/check-metadata-freshness.ts || pnpm generate:metadata",
    "build": "tsup",
    "start": "node dist/index.js",
    "state-staleness": "tsx scripts/state-staleness.ts",
    "triage-finding": "tsx scripts/triage-finding.ts",
    "type-check": "tsc --noEmit && pnpm typecheck:templates && pnpm check:tests",
    "typecheck:templates": "tsc --noEmit -p templates/react/tsconfig.json && vue-tsc --noEmit -p templates/vue/tsconfig.json && tsc --noEmit -p templates/angular/tsconfig.json",
    "check:tests": "tsx scripts/check-tests-baseline.ts",
    "check:mocks": "tsx scripts/check-mock-budget.ts",
    "test": "vitest run tests/unit --config vitest.unit.config.ts",
    "test:coverage": "vitest run tests/unit --config vitest.unit.config.ts --coverage",
    "coverage:all": "tsx scripts/coverage-all.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:starters": "vitest run tests/e2e/starter-snapshots.test.ts --config vitest.e2e.config.ts --testTimeout=600000",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:stories": "cd docs && pnpm storybook:test",
    "update:starter-snapshots": "tsx scripts/update-starter-snapshots.ts",
    "test:all": "pnpm run build && pnpm run test && pnpm run test:integration && pnpm run test:e2e && pnpm run test:stories",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "validate:changes": "tsx scripts/validate-changes.ts",
    "validate:stories": "tsx scripts/storybook/validate-stories.ts",
    "validate:cem-sync": "tsx scripts/validate-cem-sync.ts",
    "validate:parity": "tsx scripts/validate-parity.ts",
    "validate:agents": "tsx scripts/validate-agents.ts",
    "validate:generated-fresh": "tsx scripts/check-generated-fresh.ts",
    "generate:stories": "tsx scripts/storybook/patch-stories.ts",
    "validate:all": "pnpm validate:registry && pnpm validate:templates && pnpm validate:changes && pnpm validate:stories && pnpm validate:cem-sync && pnpm validate:parity && pnpm validate:agents && pnpm validate:generated-fresh",
    "verify:app": "tsx scripts/verify-test-app.ts",
    "lint": "eslint src tests templates \"*.config.{js,ts}\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint src tests templates \"*.config.{js,ts}\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"templates/**/*.{ts,tsx,js,jsx,vue,css}\" \"scripts/**/*.ts\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"templates/**/*.{ts,tsx,js,jsx,vue,css}\" \"scripts/**/*.ts\" \"*.{js,ts,json,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "release-readiness": "tsx scripts/release-readiness.ts run",
    "release-readiness:quick": "tsx scripts/release-readiness.ts run --quick",
    "release-readiness:dry-run": "tsx scripts/release-readiness.ts dry-run",
    "changeset": "changeset",
    "version": "changeset version && tsx scripts/post-changeset-version.ts",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "web-awesome",
    "components",
    "cli",
    "react",
    "vue",
    "ui"
  ],
  "author": "Michael Suzuki <legal@kigumi.style>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "node-diff3": "^3.2.1",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@awesome.me/webawesome": "3.8.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "c8": "^11.0.0",
    "clsx": "^2.1.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "vue": "^3.5.38",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
