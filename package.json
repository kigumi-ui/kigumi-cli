{
  "name": "@kigumi/cli",
  "version": "0.1.0",
  "description": "CLI tool to add Web Awesome components to your project",
  "type": "module",
  "bin": {
    "kigumi": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "web-awesome",
    "components",
    "cli",
    "react",
    "vue",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.0.0",
    "cosmiconfig": "^9.0.0",
    "handlebars": "^4.7.8",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
