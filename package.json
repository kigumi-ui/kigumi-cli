{
  "name": "@kigumi/cli",
  "version": "0.2.0",
  "description": "CLI tool to add Web Awesome components to your project",
  "type": "module",
  "bin": {
    "kigumi": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts && cp -r templates dist/",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e --testTimeout=300000",
    "test:all": "vitest run",
    "verify:app": "tsx scripts/verify-test-app.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,json,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "keywords": [
    "web-awesome",
    "components",
    "cli",
    "react",
    "vue",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  }
}
